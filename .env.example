# Copy this file to .env and add your Anthropic API key.
ANTHROPIC_API_KEY=your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-6
# Off by default. Turning it on sends resume text to Anthropic for suggestions.
CLAUDE_SUGGESTIONS_ENABLED=false

# Set a long random value before deploying.
DJANGO_SECRET_KEY=
# Set to false in production.
DJANGO_DEBUG=true
# Comma-separated hosts, for example api.example.com
DJANGO_ALLOWED_HOSTS=
# Comma-separated frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173